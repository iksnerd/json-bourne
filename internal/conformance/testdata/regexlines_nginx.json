{
 "plugin": "regexlines",
 "config": {
  "pattern": "^(?P<ip>\\S+) \\S+ \\S+ \\[[^\\]]+\\] \"(?P<method>[A-Z]+) (?P<path>[^?#\\s]*)\\S* [^\"]+\" (?P<status>\\d{3}) (?:\\d+|-) \"(?P<referer>[^\"]*)\" \"(?P<ua>[^\"]*)\"",
  "fields": {
   "client_ip": {
    "from": "ip",
    "type": "ip",
    "required": true
   },
   "method": {
    "from": "method",
    "required": true
   },
   "path": {
    "from": "path",
    "required": true
   },
   "status": {
    "from": "status",
    "type": "int",
    "required": true
   },
   "user_agent": {
    "from": "ua",
    "omit": [
     "-"
    ]
   },
   "referer": {
    "from": "referer",
    "omit": [
     "-"
    ]
   }
  }
 },
 "builtin": "nginx_ingress",
 "cases": [
  {
   "name": "normal login failure, referer dash omitted",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z",
    "message": "192.0.2.10 - - [05/Nov/2026:12:00:01 +0000] \"POST /auth/login HTTP/1.1\" 401 52 \"-\" \"ExampleAgent/1.0\" 310 0.004 [example-svc-80] [] 10.0.0.5:8080 52 0.004 200 req0001"
   },
   "want": {
    "ts": "2026-11-05T12:00:00Z",
    "fields": {
     "client_ip": "192.0.2.10",
     "method": "POST",
     "path": "/auth/login",
     "status": 401,
     "user_agent": "ExampleAgent/1.0"
    }
   },
   "builtin": true
  },
  {
   "name": "quoted UA with spaces and a referer",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z",
    "message": "192.0.2.11 - - [05/Nov/2026:12:00:01 +0000] \"GET /home HTTP/2.0\" 200 52 \"https://www.example.com/start?x=1\" \"Example Browser 2.1 (Test OS; rv:1) Gecko/20260101 Fake/9.9\" 310 0.004 [example-svc-80] [] 10.0.0.5:8080 52 0.004 200 req0001"
   },
   "want": {
    "ts": "2026-11-05T12:00:00Z",
    "fields": {
     "client_ip": "192.0.2.11",
     "method": "GET",
     "path": "/home",
     "status": 200,
     "user_agent": "Example Browser 2.1 (Test OS; rv:1) Gecko/20260101 Fake/9.9",
     "referer": "https://www.example.com/start?x=1"
    }
   },
   "builtin": true
  },
  {
   "name": "query string is not part of the path",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z",
    "message": "192.0.2.12 - - [05/Nov/2026:12:00:01 +0000] \"GET /search/items?q=a+b&page=2 HTTP/1.1\" 200 52 \"-\" \"ExampleAgent/1.0\" 310 0.004 [example-svc-80] [] 10.0.0.5:8080 52 0.004 200 req0001"
   },
   "want": {
    "ts": "2026-11-05T12:00:00Z",
    "fields": {
     "client_ip": "192.0.2.12",
     "method": "GET",
     "path": "/search/items",
     "status": 200,
     "user_agent": "ExampleAgent/1.0"
    }
   },
   "builtin": true
  },
  {
   "name": "fragment removed and a dash user agent omitted",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z",
    "message": "192.0.2.14 - - [05/Nov/2026:12:00:01 +0000] \"GET /page#frag HTTP/1.1\" 200 52 \"-\" \"-\" 310 0.004 [example-svc-80] [] 10.0.0.5:8080 52 0.004 200 req0001"
   },
   "want": {
    "ts": "2026-11-05T12:00:00Z",
    "fields": {
     "client_ip": "192.0.2.14",
     "method": "GET",
     "path": "/page",
     "status": 200
    }
   },
   "builtin": true
  },
  {
   "name": "IPv6 client",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z",
    "message": "2001:db8::1 - - [05/Nov/2026:12:00:01 +0000] \"GET /v6 HTTP/1.1\" 404 52 \"-\" \"ExampleAgent/1.0\" 310 0.004 [example-svc-80] [] 10.0.0.5:8080 52 0.004 200 req0001"
   },
   "want": {
    "ts": "2026-11-05T12:00:00Z",
    "fields": {
     "client_ip": "2001:db8::1",
     "method": "GET",
     "path": "/v6",
     "status": 404,
     "user_agent": "ExampleAgent/1.0"
    }
   },
   "builtin": true
  },
  {
   "name": "referer is not the path, upstream status is not the status",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z",
    "message": "192.0.2.13 - - [05/Nov/2026:12:00:01 +0000] \"GET /static/app.js HTTP/1.1\" 304 52 \"https://www.example.com/auth/login\" \"ExampleAgent/1.0\" 310 0.004 [example-svc-80] [] 10.0.0.5:8080 52 0.004 200 req0001"
   },
   "want": {
    "ts": "2026-11-05T12:00:00Z",
    "fields": {
     "client_ip": "192.0.2.13",
     "method": "GET",
     "path": "/static/app.js",
     "status": 304,
     "user_agent": "ExampleAgent/1.0",
     "referer": "https://www.example.com/auth/login"
    }
   },
   "builtin": true
  },
  {
   "name": "timestamp offset is normalised to UTC",
   "doc": {
    "@timestamp": "2026-11-05T14:30:00.123+02:00",
    "message": "192.0.2.15 - - [05/Nov/2026:12:00:01 +0000] \"GET /ok HTTP/1.1\" 200 52 \"-\" \"ExampleAgent/1.0\" 310 0.004 [example-svc-80] [] 10.0.0.5:8080 52 0.004 200 req0001"
   },
   "want": {
    "ts": "2026-11-05T12:30:00.123Z",
    "fields": {
     "client_ip": "192.0.2.15",
     "method": "GET",
     "path": "/ok",
     "status": 200,
     "user_agent": "ExampleAgent/1.0"
    }
   },
   "builtin": true
  },
  {
   "name": "first field is not an IP address",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z",
    "message": "not-an-ip - - [05/Nov/2026:12:00:01 +0000] \"GET / HTTP/1.1\" 200 52 \"-\" \"x\" 310 0.004 [example-svc-80] [] 10.0.0.5:8080 52 0.004 200 req0001"
   },
   "unparsable": true,
   "builtin": true
  },
  {
   "name": "not an access line",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z",
    "message": "hello this is not an access line"
   },
   "unparsable": true,
   "builtin": true
  },
  {
   "name": "document without a message field",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z"
   },
   "unparsable": true,
   "builtin": true
  },
  {
   "name": "message is not text",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z",
    "message": 12345
   },
   "unparsable": true,
   "builtin": true
  },
  {
   "name": "line over the plugin size cap",
   "doc": {
    "@timestamp": "2026-11-05T12:00:00Z",
    "message": "192.0.2.16 - - [05/Nov/2026:12:00:01 +0000] \"GET / HTTP/1.1\" 200 52 \"-\" \"x\" 310 0.004 [example-svc-80] [] 10.0.0.5:8080 52 0.004 200 "
   },
   "unparsable": true,
   "builtin": false
  },
  {
   "name": "bad @timestamp is a fault in the document set, not an odd line",
   "doc": {
    "@timestamp": "yesterday",
    "message": "192.0.2.17 - - [05/Nov/2026:12:00:01 +0000] \"GET / HTTP/1.1\" 200 52 \"-\" \"x\" 310 0.004 [example-svc-80] [] 10.0.0.5:8080 52 0.004 200 req0001"
   },
   "fatal": "bad or missing @timestamp",
   "builtin": true
  }
 ]
}