package web

// ---- estate ----

templ estateView(p estatePage) {
	@layout(p.Title, p.Nav) {
		<h1>Estate</h1>
		if p.NotWired {
			@alert("muted") {
				estate is not available: start with `jb serve --case DIR` so the case's estate directory is known.
			}
		} else if p.Note.Bad() {
			@noteView(p.Note)
		} else {
			<form class="filters" role="search" action="/estate" method="get" hx-get="/estate" hx-trigger="change" hx-target="#estate-graphs" hx-swap="innerHTML" hx-push-url="false">
				<fieldset>
					<legend class="label">node kind (none chosen shows all)</legend>
					for _, o := range p.KindOptions() {
						<label class="label"><input type="checkbox" name="kind" value={ o.Kind } checked?={ o.Checked }/> { o.Kind }</label>
					}
				</fieldset>
				<fieldset>
					<legend class="label">edge confidence (none chosen shows all)</legend>
					for _, o := range p.ConfOptions() {
						<label class="label"><input type="checkbox" name="confidence" value={ o.Confidence } checked?={ o.Checked }/> { o.Confidence }</label>
					}
				</fieldset>
				<noscript><button class="btn btn-primary" type="submit">filter</button></noscript>
			</form>
			<p>
				<label class="label" for="estate-search">find a node (/ to focus, Escape to clear, arrow keys to move between matches)</label>
				<input class="input" type="search" id="estate-search" autocomplete="off" placeholder="id or label" aria-controls="estate-graphs" hidden/>
				<span class="note" id="estate-search-status" aria-live="polite"></span>
			</p>
			<p>
				<button class="btn" type="button" id="estate-export-svg" hidden>export drawn graph as SVG</button>
				<button class="btn" type="button" id="estate-export-json" hidden>export drawn graph as JSON</button>
				<span class="note" id="estate-export-status" aria-live="polite"></span>
			</p>
			<div id="estate-graphs">
				@estateGraphs(p)
			</div>
			@sheet(sheetProps{ID: "estate-sheet", Title: "Record", Description: "The record of the selected node or connection: where it came from, how it was observed, and what it connects to."}) {
				<div id="estate-detail" aria-live="polite">
					<p class="note">Select a node or a connection to see its record here.</p>
				</div>
			}
			<p class="note">Tables show at most { str(p.Cap) } rows each. An estate map shows who owns and runs infrastructure, not who typed the commands.</p>
			<script src="/static/sheet.js" defer></script>
			<script src="/static/d3.min.js" defer></script>
			<script src="/static/estate.js" defer></script>
			<script src="/static/estate-search.js" defer></script>
			<script src="/static/estate-export.js" defer></script>
		}
	}
}

// estateGraphs is the part of the page the kind filter swaps: every map, filtered.
templ estateGraphs(p estatePage) {
	for _, l := range p.Layers {
		<section aria-label={ l.Heading }>
			<h2>{ l.Heading }</h2>
			for _, g := range l.Graphs {
				@graphBlock(g)
			}
		</section>
	}
}

templ graphBlock(g graphView) {
	<h3>{ g.ID }</h3>
	<p class="note">Caveat: { g.Caveat }</p>
	if g.SVG {
		<div class="graph" data-src={ g.Src }></div>
		<figure class="static-graph">
			<svg viewBox={ "0 0 " + str(g.SVGW) + " " + str(g.SVGH) } role="img" aria-label={ "estate graph " + g.ID }>
				for _, e := range g.SVGEdges {
					if e.Stale {
						<line x1={ str(e.X1) } y1={ str(e.Y1) } x2={ str(e.X2) } y2={ str(e.Y2) } stroke-dasharray="6 4"></line>
					} else {
						<line x1={ str(e.X1) } y1={ str(e.Y1) } x2={ str(e.X2) } y2={ str(e.Y2) }></line>
					}
				}
				for _, n := range g.SVGNodes {
					<a href={ templ.URL(nodeHref(n.G, n.ID)) }>
						<circle cx={ str(n.X) } cy={ str(n.Y) } r="5"></circle>
						<text x={ str(n.LX) } y={ str(n.Y + 4) }>{ n.Label }</text>
					</a>
				}
			</svg>
			if g.SVGCut {
				<p class="note">the drawing shows the { str(len(g.SVGNodes)) } most connected nodes only; the tables list every one.</p>
			}
		</figure>
	}
	if g.Filtered {
		<h3>Nodes ({ str(g.NodeShown) } of { str(g.NodeTotal) }, filtered by kind)</h3>
	} else {
		<h3>Nodes ({ str(g.NodeTotal) })</h3>
	}
	<table>
		<tr><th>kind</th><th>label</th><th>source</th><th>method</th><th>observed</th><th>facts</th></tr>
		for _, n := range g.Nodes {
			<tr>
				<td>{ n.Kind }</td>
				<td>
@nodeLink(n.G, n.ID, n.Label, true)
</td>
				<td>{ n.Source }</td>
				<td class="mono">{ n.Method }</td>
				<td>{ n.Observed }</td>
				<td>{ str(n.NFacts) }</td>
			</tr>
		}
	</table>
	if g.Filtered || g.ConfFiltered {
		<h3>Edges ({ str(g.EdgeShown) } of { str(g.EdgeTotal) }, matching the filters)</h3>
	} else {
		<h3>Edges ({ str(g.EdgeTotal) })</h3>
	}
	if len(g.Edges) > 0 {
		<table>
			<tr><th>from</th><th>relation</th><th>to</th><th>source</th><th>method</th><th>observed</th><th>confidence</th></tr>
			for _, e := range g.Edges {
				<tr>
					<td class="mono">{ e.From }</td>
					<td>
@edgeLink(e.G, e.I, e.Relation, true)
</td>
					<td class="mono">{ e.To }</td>
					<td>{ e.Source }</td>
					<td class="mono">{ e.Method }</td>
					<td>{ e.Observed }</td>
					<td>{ e.Confidence }</td>
				</tr>
			}
		</table>
	} else {
		@alert("muted") {
			no edges in this map
		}
	}
	<h3>Edge kinds drawn</h3>
	if len(g.Legend) > 0 {
		<ul id={ "legend-" + g.ID }>
			for _, r := range g.Legend {
				<li>{ r.Relation }: { str(r.N) }</li>
			}
		</ul>
		if g.LegendCut {
			<p class="note">the interactive drawing holds the most connected nodes only, so these counts are of the lines drawn, not of every edge in the file.</p>
		}
	} else {
		@alert("muted") {
			no edge drawn
		}
	}
	<h3>Absences</h3>
	if len(g.Absences) > 0 {
		<table>
			<tr><th>subject</th><th>source</th><th>method</th><th>observed</th><th>answer</th></tr>
			for _, a := range g.Absences {
				<tr><td class="mono">{ a.Subject }</td><td>{ a.Source }</td><td class="mono">{ a.Method }</td><td>{ a.Observed }</td><td>{ a.Answer }</td></tr>
			}
		</table>
	} else {
		@alert("muted") {
			no recorded absences
		}
	}
	<h3>Assessments (opinion)</h3>
	<p class="note">{ assessmentNotice }</p>
	@assessmentTable(g.Assessments, true, "no assessment in this map")
	if g.AssessmentTotal > len(g.Assessments) {
		<p class="note">showing { str(len(g.Assessments)) } of { str(g.AssessmentTotal) } assessments.</p>
	}
}

// assessmentTable lists assessments. The caller prints the heading and the fixed notice.
templ assessmentTable(rows []assessRow, withSubject bool, empty string) {
	if len(rows) > 0 {
		<table>
			<tr>
				if withSubject {
					<th>subject</th>
				}
				<th>label</th><th>by</th><th>decided</th><th>basis</th><th>note</th>
			</tr>
			for _, a := range rows {
				<tr>
					if withSubject {
						<td class="mono">{ a.Subject }</td>
					}
					<td>{ a.Label }</td><td>{ a.By }</td><td>{ a.Decided }</td>
					<td class="mono">
						for i, r := range a.Refs {
							if i > 0 {
								{ ", " }
							}
							if r.Resolved {
								<a href={ templ.URL(r.Href) }>{ r.Text }</a>
							} else {
								{ r.Text } <span class="note">(unresolved)</span>
							}
						}
					</td><td>{ a.Note }</td>
				</tr>
			}
		</table>
	} else {
		@alert("muted") {
			{ empty }
		}
	}
}

// nodeLink and edgeLink are plain links. With panel set they also ask htmx to load the
// record into #estate-detail without leaving the page; without script the link works as
// a link. They are used only where that panel exists.
templ nodeLink(g, id, text string, panel bool) {
	if panel {
		<a href={ templ.URL(nodeHref(g, id)) } hx-get={ nodeHref(g, id) } hx-target="#estate-detail" hx-swap="innerHTML" hx-push-url="false">{ text }</a>
	} else {
		<a href={ templ.URL(nodeHref(g, id)) }>{ text }</a>
	}
}

templ edgeLink(g string, i int, text string, panel bool) {
	if panel {
		<a href={ templ.URL(edgeHref(g, i)) } hx-get={ edgeHref(g, i) } hx-target="#estate-detail" hx-swap="innerHTML" hx-push-url="false">{ text }</a>
	} else {
		<a href={ templ.URL(edgeHref(g, i)) }>{ text }</a>
	}
}

// nodeView is the node record as a page; nodeRecord is the same record as the fragment
// that htmx puts into the panel on the estate page.
templ nodeView(p nodePage) {
	@layout(p.Title, p.Nav) {
		<h1>Node <span class="mono">{ p.Node.Label }</span></h1>
		@nodeRecord(p, false)
	}
}

templ nodeRecord(p nodePage, panel bool) {
	<p class="note">Caveat: { p.Caveat }</p>
	<table>
		<tr><th>id</th><td class="mono">{ p.Node.ID }</td></tr>
		<tr><th>kind</th><td>{ p.Node.Kind }</td></tr>
		<tr><th>source</th><td>{ p.Node.Source }</td></tr>
		<tr><th>method</th><td class="mono">{ p.Node.Method }</td></tr>
		<tr><th>observed</th><td>{ p.Node.Observed }</td></tr>
		<tr><th>map</th><td>{ p.GraphID }</td></tr>
	</table>
	<h2>Where this node comes from</h2>
	<table>
		<tr><th>estate file (id)</th><th>layer</th><th></th></tr>
		for _, o := range p.Origins {
			<tr>
				<td class="mono">{ o.Map }</td>
				<td>{ o.Layer }</td>
				<td>
					if o.Here {
						this sheet
					} else {
						<a href={ templ.URL(o.Href) }>open this node in that file</a>
					}
				</td>
			</tr>
		}
	</table>
	<h2>Facts</h2>
	if len(p.Facts) > 0 {
		for _, grp := range p.Facts {
			<h3 class="mono" id={ grp.ID }>{ grp.Key }</h3>
			for _, ct := range grp.Cited {
				<p class="note">Cited by an assessment (opinion): { ct.Label } by { ct.By }, decided { ct.Decided }.</p>
			}
			<table>
				<tr><th>value</th><th>source</th><th>method</th><th>observed</th></tr>
				for _, f := range grp.Facts {
					<tr><td class="mono">{ f.Value }</td><td>{ f.Source }</td><td class="mono">{ f.Method }</td><td>{ f.Observed }</td></tr>
				}
			</table>
		}
	} else {
		@alert("muted") {
			no recorded fact about this node
		}
	}
	<h2>Connections</h2>
	if len(p.Edges) > 0 {
		for _, grp := range p.Edges {
			<h3>{ grp.Relation }</h3>
			<table>
				<tr><th>direction</th><th>other node</th><th>source</th><th>method</th><th>confidence</th><th>observed</th></tr>
				for _, e := range grp.Rows {
					<tr>
						<td>
@edgeLink(e.G, e.I, e.Dir, panel)
</td>
						<td class="mono">
@nodeLink(e.G, e.Other, e.Other, panel)
</td>
						<td>{ e.Source }</td>
						<td class="mono">{ e.Method }</td>
						<td>{ e.Confidence }</td>
						<td>{ e.Observed }</td>
					</tr>
				}
			</table>
		}
		if p.EdgeTotal > tableCap {
			<p class="note">showing { str(tableCap) } of { str(p.EdgeTotal) } edges.</p>
		}
	} else {
		@alert("muted") {
			no edge touches this node
		}
	}
	<h2>Absences</h2>
	if len(p.Absences) > 0 {
		<table>
			<tr><th>source</th><th>method</th><th>observed</th><th>answer</th></tr>
			for _, a := range p.Absences {
				<tr><td>{ a.Source }</td><td class="mono">{ a.Method }</td><td>{ a.Observed }</td><td>{ a.Answer }</td></tr>
			}
		</table>
	} else {
		@alert("muted") {
			no recorded absence about this node
		}
	}
	<h2>Assessments (opinion)</h2>
	<p class="note">{ assessmentNotice }</p>
	@assessmentTable(p.Assess, false, "no assessment about this node")
	<h2>Assessments citing this node (opinion)</h2>
	<p class="note">{ assessmentNotice }</p>
	@assessmentTable(p.Citing, true, "no assessment cites this node in its basis")
	if p.OverlayHref != "" {
		if panel {
			<div hx-get={ p.OverlayHref } hx-trigger="load" hx-swap="innerHTML">
				<p class="note">Reading reputation and last seen from the evidence store...</p>
			</div>
		} else {
			<p class="note"><a href={ templ.URL(p.OverlayHref) }>read reputation and last seen for this address</a></p>
		}
	}
	if panel {
		<p class="note"><a href={ templ.URL(nodeHref(p.Node.G, p.Node.ID)) }>open this record as a page</a></p>
	}
}

// overlayFragment is the overlay of an ip node: plain text lines, no verdict colour. The
// record's panel asks for it when the record opens; the map load never does.
templ overlayFragment(p overlayPage) {
	<h2>Reputation and logs</h2>
	<p class="note">{ overlayNotice }</p>
	<ul>
		for _, l := range p.Lines {
			<li>{ l }</li>
		}
	</ul>
}

templ overlayView(p overlayPage) {
	@layout(p.Title, p.Nav) {
		<h1>Overlay <span class="mono">{ p.Label }</span></h1>
		@overlayFragment(p)
	}
}

templ edgeView(p edgePage) {
	@layout(p.Title, p.Nav) {
		<h1>Edge <span class="mono">{ p.Edge.Relation }</span></h1>
		@edgeRecord(p, false)
	}
}

templ edgeRecord(p edgePage, panel bool) {
	<p class="note">Caveat: { p.Caveat }</p>
	<table>
		<tr><th>from</th><td class="mono">
@nodeLink(p.Edge.G, p.Edge.From, p.Edge.From, panel)
</td></tr>
		<tr><th>to</th><td class="mono">
@nodeLink(p.Edge.G, p.Edge.To, p.Edge.To, panel)
</td></tr>
		<tr><th>relation</th><td>{ p.Edge.Relation }</td></tr>
		<tr><th>source</th><td>{ p.Edge.Source }</td></tr>
		<tr><th>method</th><td class="mono">{ p.Edge.Method }</td></tr>
		<tr><th>observed</th><td>{ p.Edge.Observed }</td></tr>
		<tr><th>confidence</th><td>{ p.Edge.Confidence }</td></tr>
		<tr><th>corroboration</th><td>{ p.Corr.Plural() }: <span class="mono">{ p.Corr.Sources }</span></td></tr>
		<tr><th>newest claim</th><td>{ p.Corr.Newest }</td></tr>
		if p.Corr.Stale {
			<tr><th>age</th><td>stale: the newest claim is older than 90 days</td></tr>
		}
		if p.Edge.InferredFrom != "" {
			<tr><th>inferred from</th><td>{ p.Edge.InferredFrom }</td></tr>
		}
		<tr><th>map</th><td>{ p.GraphID }</td></tr>
	</table>
	if panel {
		<p class="note"><a href={ templ.URL(edgeHref(p.Edge.G, p.Edge.I)) }>open this record as a page</a></p>
	}
}
