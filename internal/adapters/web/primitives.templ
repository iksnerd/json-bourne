package web

// The primitives of the dashboard, in the manner of shadcn/ui: small components whose
// look comes from the design tokens in assets/input.css and whose variants are named,
// not styled at the call site. A page composes these; it does not write colours.

// card is a panel with corner ticks.
templ card() {
	<section class="card">
		{ children... }
	</section>
}

// alert is a boxed message. destructive is a failure (and says so to assistive
// technology); muted is an answer such as "nothing stored", which is not a failure.
templ alert(variant string) {
	if variant == "destructive" {
		<div class="alert alert-destructive" role="alert">
			{ children... }
		</div>
	} else {
		<div class="alert alert-muted">
			{ children... }
		</div>
	}
}

// badge is a short status label: outline, destructive, warning or success.
templ badge(variant string) {
	<span class={ "badge", "badge-" + badgeVariant(variant) }>{ children... }</span>
}

// sheetProps configure a sheet.
//
//	ID          unique id of the sheet; its parts derive from it (<id>-title, <id>-desc)
//	Title       the accessible name and the visible heading (required)
//	Description optional one line that assistive technology reads with the title
//	Side        "right" (default), "left" or "bottom"; anything else is "right"
//	Modal       true: an overlay, a focus trap, the page behind is inert and does not
//	            scroll; false (default): the page stays usable beside the sheet
type sheetProps struct {
	ID, Title, Description, Side string
	Modal                        bool
}

func (p sheetProps) side() string {
	switch p.Side {
	case "left", "bottom":
		return p.Side
	}
	return "right"
}

// sheet is a panel that slides in from an edge and holds a record. It follows the
// WAI-ARIA dialog pattern (role dialog, named by its title, aria-modal set honestly) and
// the data attributes of Radix and shadcn/ui (data-state, data-side). All behaviour is in
// static/sheet.js: open and close, Escape, focus moved in and restored, a focus trap and
// scroll lock when modal, inert while closed so a closed sheet is neither focusable nor
// read. Without script it stays closed and the links that would have filled it go to the
// record's own page.
//
// Open it with a trigger carrying data-sheet-open="<id>" (it gets aria-controls and
// aria-expanded), with sheet:open dispatched on the sheet, or by swapping htmx content
// into anything inside it: a swap into a sheet opens it.
templ sheet(p sheetProps) {
	<div class="sheet-root" data-sheet-root={ p.ID }>
		if p.Modal {
			<div class="sheet-overlay" data-sheet-overlay={ p.ID } data-state="closed"></div>
		}
		<div
			id={ p.ID }
			class="sheet"
			role="dialog"
			if p.Modal {
				aria-modal="true"
			} else {
				aria-modal="false"
			}
			aria-labelledby={ p.ID + "-title" }
			if p.Description != "" {
				aria-describedby={ p.ID + "-desc" }
			}
			data-sheet
			data-state="closed"
			data-side={ p.side() }
			data-modal={ boolAttr(p.Modal) }
			tabindex="-1"
			inert
		>
			<div class="sheet-head">
				<h2 id={ p.ID + "-title" } class="sheet-title">{ p.Title }</h2>
				<button type="button" class="btn" data-sheet-close aria-label={ "Close " + p.Title }>Close</button>
			</div>
			if p.Description != "" {
				<p id={ p.ID + "-desc" } class="sheet-desc">{ p.Description }</p>
			}
			<div class="sheet-body">
				{ children... }
			</div>
		</div>
	</div>
}
