{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/jb/schemas/actor.schema.json",
  "title": "jb actor file (apiVersion jb.actor/v1)",
  "description": "Mirrors internal/casefile/actor.go. internal/casefile/actor_test.go fails when the property names, required keys or enums drift. Rules a schema cannot express (path confinement, symlinks, credential shape, canonical IP form, duplicate indicators, file size) are enforced by the loader only; see docs/CASE-SPEC.md section 4.4.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "label", "confidence", "indicators"],
  "properties": {
    "apiVersion": { "const": "jb.actor/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 200 },
    "confidence": { "enum": ["low", "medium", "high"] },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "enum": ["ip", "asn", "user_agent", "domain", "fingerprint"] },
          "value": {
            "type": ["string", "integer"],
            "description": "Read as the text written in the file. Quote a value that YAML would read as a number if it has leading zeros."
          },
          "first_seen": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "note": { "type": "string", "minLength": 1, "maxLength": 300 },
          "type": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
          "method": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
          "probe_target": { "type": "string", "minLength": 1, "maxLength": 255 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "fingerprint" } } },
            "then": { "required": ["type", "method"] },
            "else": { "not": { "anyOf": [{ "required": ["type"] }, { "required": ["method"] }, { "required": ["probe_target"] }] } }
          }
        ]
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "noise_paths": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "minLength": 2, "maxLength": 256 },
          "description": "Case-insensitive substring markers of scanner traffic. Judged on the path without its query string."
        },
        "bare_root_4xx_is_noise": {
          "type": "boolean",
          "default": true,
          "description": "A 4xx on / is a scanner probe."
        },
        "grant_paths": {
          "type": "array",
          "maxItems": 200,
          "items": { "type": "string", "pattern": "^/[^?\\s]*$", "maxLength": 256 },
          "description": "Case-insensitive substrings of a token endpoint's path. A 2xx on one, for a genuine event of the actor, is critical."
        }
      }
    }
  }
}
