{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/jb/schemas/estate.schema.json",
  "title": "jb estate file (apiVersion jb.estate/v2)",
  "description": "Mirrors internal/casefile/estate.go. internal/casefile/estate_test.go fails when the property names, required keys or enums drift. Rules a schema cannot express (path confinement, symlinks, credential shape, dangling and duplicate ids, self edges, duplicate facts, assessment subjects and basis references that must resolve, the 20000 fact total, one-line text, file size) are enforced by the loader only; see docs/CASE-SPEC.md section 4.5. The source list is the passive-source allowlist of docs/POLICY.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "caveat", "nodes"],
  "properties": {
    "apiVersion": { "const": "jb.estate/v2" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "subject": {
      "enum": ["operated", "adversary"],
      "description": "Optional. operated: the nodes are infrastructure the case owner operates. adversary: infrastructure of an attacker or a third party seen in the evidence. Absent means unclassified. The loader cannot check that the contents match."
    },
    "caveat": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S",
      "description": "States that the map shows infrastructure ownership and relationships, not who typed the commands. Required and non-empty."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label", "source", "method", "observed"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_][a-z0-9._:/_-]{0,253}$", "description": "Starts with the kind and a colon, e.g. ip:192.0.2.10." },
          "kind": { "enum": ["ip", "host", "domain", "asn", "org", "network", "service"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 255 },
          "source": { "enum": ["rdap", "rdns", "dns", "whois", "crt.sh", "ct-log", "bgp", "passive-dns", "scan-cache"] },
          "method": { "type": "string", "minLength": 1, "maxLength": 500, "description": "How it was obtained, e.g. the exact query." },
          "observed": { "type": "string", "format": "date-time" },
          "facts": {
            "type": "array",
            "maxItems": 50,
            "description": "Observations about this node. Two facts of one node may share a key; an identical key, value, source and method is a duplicate. A judgement is not a fact: use assessments.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value", "source", "method", "observed"],
              "properties": {
                "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$", "description": "Recommended: port.open, os, tls.cn, cpe, vuln, tech." },
                "value": { "type": "string", "minLength": 1, "maxLength": 500, "description": "Text, read as written (22 is the text 22). One line." },
                "source": { "enum": ["rdap", "rdns", "dns", "whois", "crt.sh", "ct-log", "bgp", "passive-dns", "scan-cache"] },
                "method": { "type": "string", "minLength": 1, "maxLength": 500 },
                "observed": { "type": "string", "format": "date-time" }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation", "source", "method", "observed"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "relation": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "source": { "enum": ["rdap", "rdns", "dns", "whois", "crt.sh", "ct-log", "bgp", "passive-dns", "scan-cache"] },
          "method": { "type": "string", "minLength": 1, "maxLength": 500 },
          "observed": { "type": "string", "format": "date-time" },
          "confidence": { "enum": ["stated", "inferred"] },
          "inferred_from": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "allOf": [
          {
            "if": { "required": ["confidence"], "properties": { "confidence": { "const": "inferred" } } },
            "then": { "required": ["inferred_from"] },
            "else": { "not": { "required": ["inferred_from"] } }
          }
        ]
      }
    },
    "absences": {
      "type": "array",
      "maxItems": 5000,
      "description": "Real not-found answers (an RDAP 404, an NXDOMAIN). A failed or timed-out lookup is never recorded here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "source", "method", "observed", "answer"],
        "properties": {
          "subject": { "type": "string" },
          "source": { "enum": ["rdap", "rdns", "dns", "whois", "crt.sh", "ct-log", "bgp", "passive-dns", "scan-cache"] },
          "method": { "type": "string", "minLength": 1, "maxLength": 500 },
          "observed": { "type": "string", "format": "date-time" },
          "answer": { "const": "not_found" }
        }
      }
    },
    "assessments": {
      "type": "array",
      "maxItems": 2000,
      "description": "Judgements by an author about a node. Opinion, not observation. Not compared by the drift check.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "label", "by", "decided", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$", "description": "Unique among the assessments of the file." },
          "subject": { "type": "string", "description": "A node id in the same file." },
          "label": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
          "by": { "type": "string", "minLength": 1, "maxLength": 128, "description": "Who decided: a role or a handle." },
          "decided": { "type": "string", "format": "date-time" },
          "basis": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "description": "A node id in the file, or <node id>#<fact key> of a node that has such a fact." }
          },
          "note": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
