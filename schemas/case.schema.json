{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/jb/schemas/case.schema.json",
  "title": "jb case file (apiVersion jb.case/v1)",
  "description": "Mirrors internal/casefile. internal/casefile/schema_test.go fails when the property names, required keys or enums drift. Rules a schema cannot express (path confinement, symlinks, credential shape, CIDR masking, git ignore) are enforced by the loader only; see docs/CASE-SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "id", "title", "status", "opened"],
  "properties": {
    "apiVersion": { "const": "jb.case/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "status": { "enum": ["open", "monitoring", "closed"] },
    "opened": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "classification": { "type": "string", "minLength": 1, "maxLength": 64, "default": "internal" },
    "owners": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
      "default": []
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "domains": { "type": "array", "items": { "type": "string", "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$" } },
        "hosts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "asns": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 4294967295 } },
        "cidrs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$" } }
      }
    },
    "windows": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
      "additionalProperties": { "type": "string", "pattern": "^[1-9][0-9]{0,3}[hd]$" },
      "default": { "default": "24h" }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_days": { "type": "integer", "minimum": 1, "maximum": 3650, "default": 90 },
        "findings_days": { "type": "integer", "minimum": 1, "maximum": 3650, "default": 365 }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assets": { "$ref": "#/$defs/relpath", "default": "assets" },
        "actors": { "$ref": "#/$defs/relpath", "default": "actors" },
        "estate": { "$ref": "#/$defs/relpath", "default": "estate" },
        "notes": { "$ref": "#/$defs/relpath", "default": "notes" },
        "reports": { "$ref": "#/$defs/relpath", "default": "reports" },
        "evidence": { "$ref": "#/$defs/relpath", "default": "evidence" }
      }
    },
    "config": { "type": "array", "items": { "$ref": "#/$defs/relpath" }, "uniqueItems": true, "default": [] },
    "handling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passive_only": { "const": true, "default": true },
        "redact_in_reports": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["ip", "email", "hostname", "account_id", "user_agent"] },
          "default": ["email"]
        }
      }
    }
  },
  "$defs": {
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!(?:.*/)?\\.\\.(?:/|$)).+$",
      "description": "Relative, forward slashes, no '..' element. Symlink confinement is checked by the loader."
    }
  }
}
